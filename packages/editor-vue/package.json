  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "import": "./src/adapters/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./src/host.ts"
    },
    "./styles.css": {
      "default": "./src/ui/styles.css"
    }
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "corepack pnpm run typecheck && corepack pnpm exec vite build"
