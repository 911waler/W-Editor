{
  "name": "w-editor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#testing-capability-loader": "./src/testing/capabilityLoader.ts",
    "#testing-preview-renderer": "./src/testing/previewRenderer.ts",
    "#testing-visual-projector": "./src/testing/visualProjector.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "wEditorBaseline": {
    "cherryMarkdown": "0.11.9",
    "tiptap": "3.30.2",
    "codeMirror": "6",
    "vue": "3.5.41",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "upstreamSourceRepositories": "reference-only"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-color": "3.30.2",
    "@tiptap/extension-highlight": "3.30.2",
    "@tiptap/extension-link": "3.30.2",
    "@tiptap/extension-subscript": "3.30.2",
    "@tiptap/extension-superscript": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/extension-task-item": "3.30.2",
    "@tiptap/extension-task-list": "3.30.2",
    "@tiptap/extension-text-align": "3.30.2",
    "@tiptap/extension-text-style": "3.30.2",
    "@tiptap/extension-underline": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "@tiptap/vue-3": "3.30.2",
    "cherry-markdown": "0.11.9",
    "codemirror": "6.0.2",
    "dompurify": "3.4.14",
    "echarts": "6.1.0",
    "highlight.js": "11.12.0",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "katex": "0.16.47",
    "mermaid": "11.17.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.13.0",
    "eslint": "10.9.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "scripts": {
    "preinstall": "node scripts/verify-package-manager.mjs --install",
    "guard:lockfiles": "node scripts/verify-package-manager.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "dev": "vite",
    "build": "corepack pnpm run typecheck && vite build",
    "build:e2e": "corepack pnpm run typecheck && vite build --mode e2e && corepack pnpm --filter @w-editor/editor-web run build && corepack pnpm --filter @w-editor/nwu-host run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:e2e": "corepack pnpm run build:e2e && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "workspace-typecheck": "pnpm --recursive --if-present run typecheck",
    "workspace-build": "pnpm --recursive --if-present run build",
    "verify:dependencies": "node scripts/verify-runtime-dependencies.mjs",
    "typecheck": "node scripts/verify-release-version-sources.mjs && vue-tsc --build --force",
    "lint": "eslint eslint.config.js playwright.config.ts vite.config.ts vitest.config.ts src packages apps examples tests e2e scripts --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "diagnostic:1mb": "playwright test e2e/approximately-1mb-diagnostic.spec.ts",
    "performance:baseline": "node scripts/measure-performance-baseline.mjs",
    "verify:performance-baseline": "node scripts/validate-performance-baseline.mjs",
    "capture:baseline-references": "node scripts/capture-baseline-visual-references.mjs",
    "report:renderer-parity-candidates": "node --experimental-strip-types scripts/report-renderer-parity-candidates.mjs",
    "generate:web-manifest": "node scripts/generate-web-distribution-manifest.mjs",
    "generate:release-version-sources": "node scripts/generate-release-version-sources.mjs",
    "verify:release-version-sources": "node scripts/verify-release-version-sources.mjs",
    "verify:release-versions": "node scripts/verify-release-versions.mjs --evidence=artifacts/release-governance/task-9-1-current-verification.json",
    "release:verify": "node scripts/release-pipeline.mjs",
    "verify:web-manifest": "node scripts/verify-web-distribution-manifest.mjs",
    "verify:seam:absent": "node scripts/verify-e2e-build-seam.mjs absent",
    "verify:seam:present": "node scripts/verify-e2e-build-seam.mjs present",
    "verify-package-boundaries": "node scripts/verify-workspace-dependencies.mjs",
    "verify:code-ownership": "node scripts/verify-code-ownership.mjs && node scripts/verify-web-entry-facades.mjs",
    "verify-feature-manifest": "node scripts/verify-workspace-feature-manifest.mjs",
    "test:system-browsers": "node scripts/system-browser-smoke.mjs",
    "test:desktop-tauri": "node scripts/desktop-tauri-webdriver.mjs",
    "test:desktop-shell": "node scripts/desktop-tauri-shell.mjs",
    "test:desktop-state": "node scripts/desktop-tauri-state.mjs",
    "test:desktop-lifecycle-ui": "node scripts/desktop-tauri-lifecycle-ui.mjs",
    "test:desktop-file-request": "node scripts/desktop-tauri-file-request.mjs",
    "test:desktop-data-root-recovery": "node scripts/desktop-tauri-data-root-recovery.mjs",
    "verify:desktop-file-association": "node scripts/verify-desktop-file-association-contract.mjs",
    "verify:desktop-installer": "node scripts/verify-desktop-installer-packages.mjs",
    "test:desktop-uninstall-data": "node scripts/desktop-tauri-uninstall-data.mjs",
    "test:desktop-update-info": "node scripts/desktop-tauri-update-info.mjs",
    "test:desktop-feature-matrix": "node scripts/desktop-tauri-feature-matrix.mjs",
    "verify:desktop-signature": "node scripts/verify-desktop-signature.mjs",
    "verify:desktop-installed-lifecycle": "node scripts/verify-desktop-installed-lifecycle.mjs",
    "test:desktop-installer-lifecycle": "node scripts/desktop-installer-lifecycle.mjs",
    "generate:desktop-manifest": "node scripts/generate-desktop-release-manifest.mjs",
    "finalize:release-manifest": "node scripts/finalize-release-manifest.mjs",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs --evidence=artifacts/release-governance/task-9-3-current-verification.json",
    "generate:release-licenses": "node scripts/generate-release-license-bundle.mjs",
    "verify:release-licenses": "node scripts/verify-release-license-bundle.mjs",
    "verify:release-closures": "node scripts/verify-release-artifact-closures.mjs",
    "test:release-feature-parity": "node scripts/web-feature-parity.mjs",
    "test:release-browser-matrix": "node scripts/browser-release-matrix.mjs",
    "test:release-accessibility": "node scripts/release-accessibility.mjs",
    "test:release-performance-focused": "node scripts/release-performance-focused.mjs",
    "test:release-performance": "node scripts/release-performance.mjs",
    "verify:release-performance": "node scripts/verify-release-performance.mjs",
    "test:release-upgrade-rollback": "node scripts/release-upgrade-rollback.mjs",
    "verify:formal-release-gate": "node scripts/verify-formal-release-gate.mjs",
    "test:release-nvda": "node scripts/windows-nvda-journey.mjs",
    "sign:desktop": "node scripts/sign-desktop-artifacts.mjs",
    "test:desktop-continuous-input": "node scripts/desktop-tauri-continuous-input.mjs",
    "test:desktop-ime": "node scripts/desktop-tauri-ime.mjs",
    "test:web-ime": "node scripts/web-real-ime.mjs",
    "test:desktop-security": "node scripts/desktop-tauri-security.mjs",
    "test:desktop-data-root": "node scripts/desktop-tauri-data-root.mjs",
    "test:desktop-library": "node scripts/desktop-tauri-library.mjs",
    "test:desktop-import": "node scripts/desktop-tauri-import.mjs",
    "test:desktop-storage": "node scripts/desktop-tauri-storage.mjs",
    "test:desktop-lifecycle": "node scripts/desktop-tauri-lifecycle.mjs",
    "test:desktop-drawio": "node scripts/desktop-tauri-drawio.mjs",
    "test:desktop-installer-build": "node scripts/desktop-tauri-bundle-build.mjs",
    "verify:desktop-msi-events": "node scripts/verify-msi-install-events.mjs",
    "test:desktop-reopen-status": "node scripts/desktop-tauri-reopen-status.mjs",
    "trial:production": "node scripts/production-hands-on-trial.mjs",
    "verify:vitest-classification": "node scripts/validate-vitest-classification.mjs",
    "validate:docs": "node scripts/validate-toolbar-matrix.mjs && vitest run tests/services/featureManifest.spec.ts tests/services/visualReferenceFreeze.spec.ts tests/services/toolbarMatrix.spec.ts tests/services/userAcceptanceRemediationMatrix.spec.ts tests/services/toolbarComponentParityMatrix.spec.ts tests/services/referenceBaselineManifest.spec.ts tests/services/releaseDocumentationValidation.spec.ts && node scripts/validate-acceptance-checklist.mjs",
    "verify:legacy-openspec-refs": "node scripts/verify-no-legacy-openspec-references.mjs",
    "validate:openspec": "corepack pnpm run verify:legacy-openspec-refs && openspec validate --specs --strict --no-interactive && openspec validate --all --strict --no-interactive",
    "verify": "pnpm run guard:lockfiles && pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run test:e2e && pnpm run build && pnpm run test:system-browsers && pnpm run validate:openspec"
  }
}
